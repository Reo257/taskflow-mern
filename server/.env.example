# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/taskflow)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173
